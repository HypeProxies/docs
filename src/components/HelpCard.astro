---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import LifeBuoy from '@lucide/astro/icons/life-buoy';
import { links } from '../lib/site';

interface Props {
  title?: string;
}

const { title = 'Still need help?' } = Astro.props;
---

<section class="card mt-48 flex flex-col gap-16 p-24 sm:flex-row sm:items-center" aria-labelledby="help-title">
  <span class="icon-tile"><LifeBuoy size={18} stroke-width={1.75} aria-hidden="true" /></span>
  <div class="min-w-0 flex-1">
    <h2 id="help-title" class="text-md font-semibold">{title}</h2>
    <p class="mt-2 text-base text-text-2">
      Open a ticket from the client area and our team will take a look, or ask in our{' '}
      <a class="text-link" href={links.discord}>Discord</a>.
    </p>
  </div>
  <a class="btn btn-primary self-start sm:self-center" href={links.ticket}>
    Open a ticket <ArrowRight size={14} aria-hidden="true" />
  </a>
</section>
