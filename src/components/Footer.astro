---
import { links } from '../lib/site';

const groups = [
  {
    title: 'Support',
    items: [
      ['Help Center', links.helpCenter],
      ['Open a ticket', links.ticket],
      ['Join Discord', links.discord],
      ['Contact', links.contact],
    ],
  },
  {
    title: 'HypeProxies',
    items: [
      ['Website', links.website],
      ['Dashboard login', links.login],
      ['Terms of service', links.terms],
      ['Privacy policy', links.privacy],
      ['Acceptable use policy', links.acceptableUse],
    ],
  },
];
---

<footer class="border-t border-stroke px-16 py-32 sm:px-32">
  <div class="mx-auto flex w-full max-w-[1120px] flex-col gap-24 text-sm text-text-2 md:flex-row md:justify-between">
    <p>© {new Date().getFullYear()} HypeProxies. All rights reserved.</p>
    <div class="grid grid-cols-2 gap-x-48 gap-y-24">
      {
        groups.map((group) => (
          <div>
            <p class="mb-8 font-semibold text-text-1">{group.title}</p>
            <ul class="flex flex-col gap-6">
              {group.items.map(([label, href]) => (
                <li>
                  <a class="footer-link rounded-swatch" href={href}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .footer-link {
    transition: color var(--c6-motion-fast) var(--c6-ease-out);
  }
  .footer-link:hover {
    color: var(--c6-text-1);
  }
</style>
