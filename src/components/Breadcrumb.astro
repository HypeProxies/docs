---
import ChevronRight from '@lucide/astro/icons/chevron-right';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="min-w-0">
  <ol class="flex min-w-0 items-center gap-6 text-base">
    <li class="flex shrink-0 items-center text-icon">
      <slot name="icon" />
    </li>
    {
      crumbs.map((crumb, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li class:list={['flex items-center gap-6', last ? 'min-w-0' : 'shrink-0 max-sm:hidden']}>
            {i > 0 && <ChevronRight size={14} class="shrink-0 text-icon" aria-hidden="true" />}
            {last ? (
              <span aria-current="page" class="min-w-0 truncate font-semibold text-text-1">
                {crumb.label}
              </span>
            ) : (
              <a href={crumb.href} class="crumb-link rounded-swatch text-text-2">
                {crumb.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumb-link {
    transition: color var(--c6-motion-fast) var(--c6-ease-out);
  }
  .crumb-link:hover {
    color: var(--c6-text-1);
  }
</style>
