---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Braces from '@lucide/astro/icons/braces';
import BookOpen from '@lucide/astro/icons/book-open';
import HelpCard from '../components/HelpCard.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Base from '../layouts/Base.astro';
import { guideUrl, links, RESELLER_API_PATH, servicesWithGuides, serviceUrl, SITE_DESCRIPTION } from '../lib/site';

const services = await servicesWithGuides();
---

<Base crumbs={[{ label: 'Docs' }]}>
  <BookOpen slot="icon" size={16} stroke-width={1.75} aria-hidden="true" />

  <header class="max-w-[720px]">
    <h1 class="text-4xl font-bold tracking-display leading-tight">HypeProxies docs</h1>
    <p class="mt-10 text-md text-text-2">{SITE_DESCRIPTION}</p>
  </header>

  <h2 class="mt-48 mb-14 text-md font-semibold">Services</h2>
  <div class="grid gap-16 md:grid-cols-2">
    {
      services.map(({ service, guides }) => (
        <section class="card flex flex-col p-20" aria-labelledby={`service-${service.id}`}>
          <div class="flex items-start justify-between gap-12">
            <span class="icon-tile">
              <ServiceIcon icon={service.data.icon} size={18} />
            </span>
            {guides.length === 0 && <span class="chip">Coming soon</span>}
          </div>
          <h3 id={`service-${service.id}`} class="mt-14 text-lg font-semibold">
            <a class="title-link rounded-swatch" href={serviceUrl(service)}>
              {service.data.title}
            </a>
          </h3>
          <p class="mt-4 text-base text-text-2">{service.data.description}</p>
          {guides.length > 0 ? (
            <ul class="mt-14 flex flex-col gap-6 border-t border-stroke pt-14 text-base">
              {guides.slice(0, 4).map((guide) => (
                <li>
                  <a class="text-link" href={guideUrl(guide)}>
                    {guide.data.title}
                  </a>
                </li>
              ))}
              {guides.length > 4 && (
                <li>
                  <a class="inline-flex items-center gap-6 text-text-2 hover:text-text-1" href={serviceUrl(service)}>
                    All {guides.length} guides <ArrowRight size={14} aria-hidden="true" />
                  </a>
                </li>
              )}
            </ul>
          ) : (
            <p class="mt-14 border-t border-stroke pt-14 text-base text-text-3">Guides for this service are on the way.</p>
          )}
        </section>
      ))
    }
  </div>

  <h2 class="mt-48 mb-14 text-md font-semibold">Developers</h2>
  <div class="tray">
    <section class="card flex flex-col gap-16 p-20 sm:flex-row sm:items-center" aria-labelledby="reseller-api">
      <span class="icon-tile"><Braces size={18} stroke-width={1.75} aria-hidden="true" /></span>
      <div class="min-w-0 flex-1">
        <h3 id="reseller-api" class="text-lg font-semibold">Reseller API</h3>
        <p class="mt-4 text-base text-text-2">
          Run a proxy reselling business on HypeProxies from your own systems: buy dedicated /24s and IP plans from
          your wallet, split them into proxy logins for your customers and get webhooks when things change.
        </p>
      </div>
      <a class="btn btn-primary self-start sm:self-center" href={RESELLER_API_PATH}>
        API reference <ArrowRight size={14} aria-hidden="true" />
      </a>
    </section>
    <div class="tray-footer">
      <span>API keys are created in the new dashboard.</span>
      <a class="inline-flex items-center gap-6 font-medium text-text-1" href={links.apiKeys}>
        API keys <ArrowRight size={14} aria-hidden="true" />
      </a>
    </div>
  </div>

  <HelpCard title="Can't find what you need?" />
</Base>

<style>
  .title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--c6-control-line);
    text-underline-offset: 3px;
  }
</style>
