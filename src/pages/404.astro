---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import FileQuestion from '@lucide/astro/icons/file-question-mark';
import Base from '../layouts/Base.astro';
import { links } from '../lib/site';
---

<Base title="Page not found" crumbs={[{ label: 'Docs', href: '/' }, { label: 'Page not found' }]}>
  <FileQuestion slot="icon" size={16} stroke-width={1.75} aria-hidden="true" />

  <section class="card max-w-[640px] p-24">
    <h1 class="text-3xl font-bold tracking-display leading-snug">Page not found</h1>
    <p class="mt-8 text-md text-text-2">
      This page does not exist or has moved. Pick a guide from the menu, search for it, or go back to{' '}
      <a class="text-link" href="/">all guides</a>.
    </p>
    <a class="btn btn-primary mt-20" href={links.ticket}>Open a ticket <ArrowRight size={14} aria-hidden="true" /></a>
  </section>
</Base>
